`include "constants.vams"
`include "disciplines.vams"

module dac_1bit(vin_dig, vout_analog);
    input vin_dig;
    output vout_analog;
    electrical vin_dig, vout_analog;

    real analog_out;

    // --- IDEAL PARAMETERS EXPOSED TO ADE ---
    parameter real VREF_HIGH = 1.0;
    parameter real VREF_LOW  = 0.0;

    parameter real delta_high = 0.0;   // IDEAL: Perfect 1.0V level
    parameter real delta_low  = 0.0;   // IDEAL: Perfect 0.0V level
    parameter real k_nl       = 0.0;   // IDEAL: Zero non-linearity
    parameter real tt         = 10p;   // IDEAL: Razor-sharp 10ps rise/fall time

    analog begin
        // The math remains exactly as you wrote it, but because the error
        // parameters are 0.0, it will output a mathematically perfect VREF.
        if (V(vin_dig) > 0.5) begin
            analog_out = (VREF_HIGH * (1 + delta_high));
            analog_out = analog_out + (k_nl * analog_out * analog_out);
        end else begin
            analog_out = (VREF_LOW * (1 + delta_low));
            analog_out = analog_out + (k_nl * analog_out * analog_out);
        end

        // Output the perfectly sharp analog step to prevent simulator interpolation errors
        V(vout_analog) <+ transition(analog_out, 0, tt, tt);
    end
endmodule
