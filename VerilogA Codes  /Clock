`include "constants.vams"
`include "disciplines.vams"

module clock_generator(clk_out, gnd); // Note: You can keep your original module name if you don't want to replace the symbol

    output clk_out;
    input gnd;
    electrical clk_out, gnd;

    // --- IDEAL PARAMETERS EXPOSED TO ADE ---
    parameter real vhigh = 1.0;
    parameter real vlow  = 0.0;
    parameter real fclk  = 10.24e6;    
    parameter real jitter = 0;       // IDEAL: Zero time error (Perfectly periodic)
    parameter real tt = 10p;           // IDEAL: Razor-sharp 10ps rise/fall time

    integer state;
    real next_edge;
    real half_period;
    integer seed;

    analog begin

        @(initial_step) begin
            seed = 28645;
            state = 0;
           
            // Calculate perfect initial half-period
            half_period = (fclk > 0) ? (0.5 / fclk) : 0.5e-6;
            next_edge = $abstime + half_period;
        end

        // The timer triggers exactly on the mathematically perfect edge
        @(timer(next_edge)) begin
            state = !state;
           
            // Recalculate period in case fclk is swept in ADE
            half_period = 0.5 / fclk;
           
            // Because jitter = 0.0, the randomizer is multiplied by zero.
            // The next edge will be perfectly uniform.
            next_edge = $abstime + half_period + (jitter * $rdist_normal(seed, 0, 1));
        end

        // Output the perfectly sharp voltage step
        V(clk_out, gnd) <+ transition(state ? vhigh : vlow, 0, tt);

    end
endmodule
